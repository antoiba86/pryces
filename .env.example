TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_GROUP_ID=your-telegram-group-id
LOGS_DIRECTORY=/tmp # automatically removed
MAX_FETCH_WORKERS=2 # max parallel requests to fetch stock data — keep low to avoid rate limiting
CACHE_TTL_SECONDS=300 # optional; seconds to cache live stock quotes. Default 300 (5 min); 0 disables
CACHE_FX_TTL_SECONDS=3600 # optional; seconds to cache FX rates. Default 3600 (1 hour); 0 disables
